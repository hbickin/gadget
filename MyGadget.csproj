<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyName>MyGadget</AssemblyName>
    <RootNamespace>MyGadget</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <Target Name="SignExecutable" AfterTargets="Build">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;try { $cert = Get-ChildItem cert:\CurrentUser\My -CodeSigningCert | Where-Object { $_.Thumbprint -eq '081A502E0247019016BDF02E71961934BCB483C4' }; if ($cert) { Set-AuthenticodeSignature -FilePath '$(OutputPath)$(AssemblyName).exe' -Certificate $cert } } catch { } exit 0&quot;" ContinueOnError="true" />
  </Target>

</Project>
